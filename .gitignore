# Compiled binaries / build output
/bin/
/go-rag
/go-rag.exe
*.exe
*.test
*.out
*.prof

# Go workspace
/go.work
/go.work.sum
/vendor/

# Test coverage
coverage.out
coverage.html

# go-rag runtime data (PRD US1) — never commit local databases
/.go-rag/

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local code-graph indexes (regenerable; keep out of git)
/.tokensave/
/.codanna/

# site/ is the public website source (spec 061) — tracked, served by GitHub Pages.

# Claude Code local settings (per-developer; never commit)
.claude/settings.local.json

# MuninnDB memory ledger + drain receipts (local runtime state, never commit)
/.claude/memory-proposals*.jsonl
/.claude/memory-proposals*.lock
/.claude/memory-drain-receipt*

# RAG book source chapters — copyrighted reference material for the audit
# (RAG_BOOK_AUDIT.md), not project code. Never commit.
/rag-book-md/
/dist/
docs/architecture/*.mermaid
